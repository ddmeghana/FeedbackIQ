# FeedbackIQ - Environment Configuration Example
# Copy this file to .env and configure your values

# Google Apps Script Web App Deployment URL
# Form submissions & Dashboard queries will be directed here
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYED_SCRIPT_ID/exec

# Configurable Gemini Model Name (Non-sensitive config)
VITE_GEMINI_MODEL=gemini-3.8-flash
