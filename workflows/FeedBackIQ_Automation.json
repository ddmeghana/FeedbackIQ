        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        848,
        320
      ],
      "id": "16d0e85d-cab5-4111-8ca3-ce3509efd6c8",
      "name": "Groq Chat Model"
      
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst raw = $json.text;\n\nif (!raw) {\n  throw new Error(\"AI response is missing.\");\n}\n\nconst cleaned = raw\n  .replace(/^```(?:json)?\\s*/i, \"\")\n  .replace(/\\s*```$/, \"\")\n  .trim();\n\nconst result = JSON.parse(cleaned);\n\nconst allowedSentiments = [\"Positive\", \"Neutral\", \"Negative\"];\nconst allowedCategories = [\n  \"Product Quality\",\n  \"Performance\",\n  \"Usability\",\n  \"Pricing\",\n  \"Customer Support\",\n  \"Delivery\",\n  \"Battery\",\n  \"Design\",\n  \"Other\"\n];\n\nif (!allowedSentiments.includes(result.sentiment)) {\n  throw new Error(\"Invalid sentiment returned by AI.\");\n}\n\nif (!allowedCategories.includes(result.category)) {\n  throw new Error(\"Invalid category returned by AI.\");\n}\n\nif (!result.summary || !result.suggested_action) {\n  throw new Error(\"AI response is missing required fields.\");\n}\n\nreturn {\n  json: {\n    sentiment: result.sentiment,\n    category: result.category,\n    summary: result.summary,\n    suggested_action: result.suggested_action\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
