    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert customer feedback analyst for FeedbackIQ.\n\nAnalyse the following individual customer feedback.\n\nProduct Name: {{ $json.Product_Name }}\nRating: {{ $json.Rating }}\nCustomer Comment: {{ $json.Comment }}\n\nPerform these four tasks:\n\n1. Sentiment Analysis:\nClassify the feedback as exactly one of: Positive, Neutral, Negative.\n\n2. Category Classification:\nChoose the single most relevant category from:\nProduct Quality, Performance, Usability, Pricing, Customer Support, Delivery, Battery, Design, Other.\n\n3. Feedback Summary:\nWrite a concise summary of the customer's main opinion or concern in 1–2 sentences.\n\n4. Suggested Action:\nRecommend one practical, specific action the organization should take based on this feedback.\n\nIMPORTANT RULES:\n- Analyse only the information provided.\n- Do not invent facts or assume details not mentioned.\n- Consider both positive and negative points if the feedback contains both.\n- Return only valid JSON.\n- Do not include Markdown code fences or additional explanations.\n\nUse exactly this JSON structure:\n\n{\n  \"sentiment\": \"Positive\",\n  \"category\": \"Performance\",\n  \"summary\": \"The customer's actual feedback summary.\",\n  \"suggested_action\": \"A practical recommended action.\"\n}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1040,
        144
      ],
      "id": "7f7eee64-1720-4c4c-a92e-7fa70600b557",
      "name": "Basic LLM Chain1"
    },
    {
