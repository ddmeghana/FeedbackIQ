/**
 * FeedbackIQ — Google Apps Script Configuration
 *
 * CONFIGURATION ARCHITECTURE:
 * The SPREADSHEET_ID is stored securely in Script Properties.
 * It is NEVER hardcoded in source code and NEVER exposed to the frontend browser.
 *
 * To configure in Apps Script:
 * Project Settings (gear icon) -> Script Properties -> Add script property:
 * Property: SPREADSHEET_ID
 * Value: <your_google_spreadsheet_id>
 */

var CONFIG = {
  // Sheet names within the FeedbackIQ Database spreadsheet
  SHEET_NAMES: {
    PRODUCTS: 'Products',
    FEEDBACK: 'Feedback',
  },

  // Products Sheet Schema (Columns A to D)
  PRODUCTS_COLUMNS: [
    'Product_ID',
    'Product_Name',
    'Description',
    'Status',
  ],

  // Feedback Sheet Schema (Columns A to M) — Exact 13 columns in order
  FEEDBACK_COLUMNS: [
    'Response_ID',       // Column A (Generated by Apps Script)
    'Timestamp',         // Column B (ISO 8601 string generated by Apps Script)
    'Product_ID',        // Column C (Validated against Products sheet)
    'Product_Name',      // Column D (Retrieved from Products sheet)
    'Respondent_Name',   // Column E (Empty string if anonymous)
    'Is_Anonymous',      // Column F (Boolean)
    'Rating',            // Column G (Integer 1 to 5)
    'Comment',           // Column H (Validated plain text, formula-sanitized)
    'Sentiment',         // Column I (Blank — reserved for Phase 8 n8n/Gemini)
    'Category',          // Column J (Blank — reserved for Phase 8 n8n/Gemini)
    'Summary',           // Column K (Blank — reserved for Phase 8 n8n/Gemini)
    'Suggested_Action',  // Column L (Blank — reserved for Phase 8 n8n/Gemini)
    'Processing_Status', // Column M (Initial value: 'Pending')
  ],

  // Validation Limits (Mirrors frontend constants)
  LIMITS: {
    COMMENT_MIN_LENGTH: 10,
    COMMENT_MAX_LENGTH: 1000,
    NAME_MAX_LENGTH: 100,
    RATING_MIN: 1,
    RATING_MAX: 5,
  },

  // LockService timeout in milliseconds to prevent concurrent write collisions
  LOCK_TIMEOUT_MS: 10000,
};

/**
 * Retrieves the bound or configured Google Spreadsheet instance.
 * Reads SPREADSHEET_ID from Script Properties.
 *
 * @returns {GoogleAppsScript.Spreadsheet.Spreadsheet}
 * @throws {Error} If SPREADSHEET_ID is missing or invalid.
 */
function getSpreadsheet() {
  var scriptProperties = PropertiesService.getScriptProperties();
  var spreadsheetId = scriptProperties.getProperty('SPREADSHEET_ID');

  if (!spreadsheetId || spreadsheetId.trim() === '') {
    // If bound directly to the sheet (container-bound script), fallback to getActiveSpreadsheet()
    try {
      var active = SpreadsheetApp.getActiveSpreadsheet();
      if (active) return active;
    } catch (e) {
      // Not a container-bound script
    }
    throw new Error('SPREADSHEET_ID is not configured in Script Properties. Please add SPREADSHEET_ID in Project Settings.');
  }

  try {
    return SpreadsheetApp.openById(spreadsheetId.trim());
  } catch (err) {
    throw new Error('Unable to open Google Spreadsheet. Verify that SPREADSHEET_ID is correct and the script has permission.');
  }
}
