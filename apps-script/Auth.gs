/**
 * FeedbackIQ — Admin Authentication & Session Management (Apps Script)
 *
 * SECURITY MODEL (ACADEMIC DEMONSTRATION / CAPSTONE PROJECT):
 * ==========================================================
 * This module implements PIN-based admin authentication designed for a
 * controlled academic demonstration. It is NOT enterprise multi-tenant authentication.
 *
 * How it works:
 *   1. Admin submits PIN via POST. PIN is verified against ADMIN_PIN stored in Script Properties.
 *   2. On success, two UUID strings generated by Utilities.getUuid() are concatenated
 *      (hyphens removed) to produce a 64-character session token.
 *   3. The token and sliding expiration timestamp are stored in Script Properties (server-side).
 *   4. Every admin API request must supply this session token in the POST body.
 *   5. The session implements a sliding 2-hour window: every valid authenticated request
 *      extends the expiration by 2 hours and returns the refreshed expiresAt timestamp.
 *   6. Failed login attempts are throttled using LockService to prevent race conditions.
 *      5 consecutive failed attempts trigger a 15-minute lockout.
 *   7. All session modifications (login, validation sliding expiry, expired session cleanup,
 *      and logout) are guarded by LockService to guarantee atomic state transitions.
 *   8. The PIN is compared using standard JavaScript string comparison (===).
 *      It is NEVER returned to the browser and NEVER committed to Git.
 *   9. Logout requires a valid session token matching the active session. Unauthenticated
 *      or mismatched logout requests are rejected and cannot invalidate another session.
 *
 * KNOWN LIMITATIONS (Documented Honestly):
 *   - Apps Script Script Properties are global to the deployed project, not per-user.
 *     Only one admin session is active at a time; logging in from a new browser replaces
 *     the previous session.
 *   - Google Apps Script does not expose caller IP addresses; throttling is applied
 *     globally to PIN attempt counts.
 *   - JavaScript string equality (===) is not constant-time.
 *   - This implementation is suitable for a student academic project, not production enterprise auth.
 *
 * Required Script Properties:
 *   ADMIN_PIN      — Admin access PIN (set in Project Settings -> Script Properties)
 *   SPREADSHEET_ID — Google Spreadsheet ID (set in Project Settings -> Script Properties)
 */

// Session duration: 2 hours in milliseconds
var ADMIN_SESSION_DURATION_MS = 2 * 60 * 60 * 1000;

// Max failed login attempts before throttle lockout
var MAX_FAILED_ATTEMPTS = 5;

// Throttle lockout period: 15 minutes in milliseconds
var THROTTLE_LOCKOUT_MS = 15 * 60 * 1000;

// LockService timeout for auth operations (5 seconds)
var AUTH_LOCK_TIMEOUT_MS = 5000;

// Keys in Script Properties
var SESSION_TOKEN_KEY = 'ADMIN_SESSION_TOKEN';
var SESSION_EXPIRY_KEY = 'ADMIN_SESSION_EXPIRY';
var FAILED_ATTEMPTS_KEY = 'ADMIN_FAILED_ATTEMPTS';
var LOCKOUT_UNTIL_KEY = 'ADMIN_LOCKOUT_UNTIL';

/**
 * Generates an unpredictable 64-character session token using two UUID v4 values.
 * Uses Google Apps Script Utilities.getUuid().
 *
 * @returns {string} 64-character hex-like token
 */
function generateSessionToken() {
  var uuid1 = Utilities.getUuid().replace(/-/g, '');
  var uuid2 = Utilities.getUuid().replace(/-/g, '');
  return uuid1 + uuid2;
}

/**
 * Verifies the admin PIN and issues a session token on success.
 * Protected by LockService against concurrent requests to prevent attempt-counter race conditions.
 *
 * @param {string} submittedPin
 * @returns {{ success: boolean, token?: string, message: string, remainingAttempts?: number, expiresAt?: string, locked?: boolean, lockContention?: boolean }}
 */
function adminLogin(submittedPin) {
  var lock = LockService.getScriptLock();
  var hasLock = lock.tryLock(AUTH_LOCK_TIMEOUT_MS);
  if (!hasLock) {
    return {
      success: false,
      lockContention: true,
      message: 'Server is busy processing another authentication request. Please try again in a few moments.',
    };
  }

  try {
    var props = PropertiesService.getScriptProperties();

    // 1. Check Lockout Status
    var lockoutUntilStr = props.getProperty(LOCKOUT_UNTIL_KEY);
    if (lockoutUntilStr) {
      var lockoutUntil = parseInt(lockoutUntilStr, 10);
      if (Date.now() < lockoutUntil) {
        var remainingMs = lockoutUntil - Date.now();
        var remainingMinutes = Math.ceil(remainingMs / 60000);
        return {
          success: false,
          locked: true,
          message: 'Too many failed attempts. Admin access is temporarily locked. Try again in ' + remainingMinutes + ' minute(s).',
          lockedUntil: new Date(lockoutUntil).toISOString(),
        };
      } else {
        // Lockout expired; reset counters under lock
        props.deleteProperty(LOCKOUT_UNTIL_KEY);
        props.deleteProperty(FAILED_ATTEMPTS_KEY);
      }
    }

    // 2. Verify Configured PIN
    var configuredPin = props.getProperty('ADMIN_PIN');
    if (!configuredPin || configuredPin.trim() === '') {
      return {
        success: false,
        message: 'Admin authentication is not configured. Please set ADMIN_PIN in Script Properties.',
      };
    }

    if (!submittedPin || typeof submittedPin !== 'string' || submittedPin.trim() === '') {
      return {
        success: false,
        message: 'PIN is required.',
      };
    }

    // Standard JavaScript string equality check
    var pinMatch = submittedPin.trim() === configuredPin.trim();

    if (!pinMatch) {
      var failedAttempts = parseInt(props.getProperty(FAILED_ATTEMPTS_KEY) || '0', 10) + 1;
      var remaining = MAX_FAILED_ATTEMPTS - failedAttempts;

      if (failedAttempts >= MAX_FAILED_ATTEMPTS) {
        var lockoutExpiry = Date.now() + THROTTLE_LOCKOUT_MS;
        props.setProperty(LOCKOUT_UNTIL_KEY, String(lockoutExpiry));
        props.deleteProperty(FAILED_ATTEMPTS_KEY);
        return {
          success: false,
          locked: true,
          message: 'Maximum login attempts reached. Admin access locked for 15 minutes.',
        };
      }

      props.setProperty(FAILED_ATTEMPTS_KEY, String(failedAttempts));
      return {
        success: false,
        message: 'Incorrect PIN. ' + remaining + ' attempt(s) remaining.',
        remainingAttempts: remaining,
      };
    }

    // 3. Success: Reset failure counters and issue session token
    props.deleteProperty(FAILED_ATTEMPTS_KEY);
    props.deleteProperty(LOCKOUT_UNTIL_KEY);

    var token = generateSessionToken();
    var expiryMs = Date.now() + ADMIN_SESSION_DURATION_MS;

    props.setProperty(SESSION_TOKEN_KEY, token);
    props.setProperty(SESSION_EXPIRY_KEY, String(expiryMs));

    return {
      success: true,
      token: token,
      message: 'Login successful.',
      expiresAt: new Date(expiryMs).toISOString(),
    };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Validates an admin session token from an incoming request.
 * Protected by LockService to guarantee atomic session validation and sliding expiry update.
 * If lock cannot be acquired, returns lockContention: true so callers do NOT falsely treat
 * temporary server contention as an expired session.
 *
 * @param {string} token - Session token from request body
 * @returns {{ valid: boolean, reason?: string, expiresAt?: string, sessionExpired?: boolean, lockContention?: boolean }}
 */
function validateAdminSession(token) {
  if (!token || typeof token !== 'string' || token.trim() === '') {
    return { valid: false, sessionExpired: true, reason: 'Session token is missing.' };
  }

  var lock = LockService.getScriptLock();
  var hasLock = lock.tryLock(AUTH_LOCK_TIMEOUT_MS);
  if (!hasLock) {
    return {
      valid: false,
      lockContention: true,
      reason: 'Authentication service is temporarily busy. Please retry in a moment.',
    };
  }

  try {
    var props = PropertiesService.getScriptProperties();
    var storedToken = props.getProperty(SESSION_TOKEN_KEY);
    var storedExpiryStr = props.getProperty(SESSION_EXPIRY_KEY);

    if (!storedToken) {
      return { valid: false, sessionExpired: true, reason: 'No active admin session. Please log in.' };
    }

    if (token.trim() !== storedToken) {
      return { valid: false, sessionExpired: true, reason: 'Invalid session token. Please log in again.' };
    }

    // Strict numeric validation of storedExpiryStr:
    // Must be a non-empty string consisting solely of digits, parsing to a positive finite integer.
    var isStrictPositiveInt = typeof storedExpiryStr === 'string' && /^\d+$/.test(storedExpiryStr.trim());
    var expiry = isStrictPositiveInt ? Number(storedExpiryStr.trim()) : NaN;

    if (isNaN(expiry) || !isFinite(expiry) || expiry <= 0 || Date.now() > expiry) {
      // Clear invalid or expired session only if stored token still matches the token being validated
      // (ensures an invalid/expired session cleanup cannot delete a newer session issued by concurrent login)
      if (props.getProperty(SESSION_TOKEN_KEY) === token.trim()) {
        props.deleteProperty(SESSION_TOKEN_KEY);
        props.deleteProperty(SESSION_EXPIRY_KEY);
      }
      var reason = (isStrictPositiveInt && !isNaN(expiry) && isFinite(expiry) && expiry > 0)
        ? 'Session has expired. Please log in again.'
        : 'Invalid or missing session expiration. Please log in again.';
      return { valid: false, sessionExpired: true, reason: reason };
    }

    // Slide session expiry on every valid authenticated request
    var newExpiry = Date.now() + ADMIN_SESSION_DURATION_MS;
    props.setProperty(SESSION_EXPIRY_KEY, String(newExpiry));

    return {
      valid: true,
      expiresAt: new Date(newExpiry).toISOString(),
    };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Invalidates the admin session (logout).
 * Protected by LockService to guarantee atomic session clearance.
 * Requires the caller's session token and verifies it matches the active session.
 * An old or mismatched token CANNOT invalidate an active session.
 *
 * @param {string} token - Session token from request body
 * @returns {{ success: boolean, message: string, lockContention?: boolean }}
 */
function adminLogout(token) {
  if (!token || typeof token !== 'string' || token.trim() === '') {
    return {
      success: false,
      message: 'Session token is required for logout.',
    };
  }

  var lock = LockService.getScriptLock();
  var hasLock = lock.tryLock(AUTH_LOCK_TIMEOUT_MS);
  if (!hasLock) {
    return {
      success: false,
      lockContention: true,
      message: 'Server is temporarily busy. Please retry in a moment.',
    };
  }

  try {
    var props = PropertiesService.getScriptProperties();
    var storedToken = props.getProperty(SESSION_TOKEN_KEY);

    if (!storedToken || token.trim() !== storedToken) {
      return {
        success: false,
        message: 'Invalid session token. Logout rejected.',
      };
    }

    props.deleteProperty(SESSION_TOKEN_KEY);
    props.deleteProperty(SESSION_EXPIRY_KEY);

    return {
      success: true,
      message: 'Logged out successfully.',
    };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Changes the admin PIN securely in Script Properties.
 * Requires verification of current PIN under LockService.
 *
 * @param {string} currentPin - The current PIN
 * @param {string} newPin - The desired new PIN
 * @returns {{ success: boolean, message: string, lockContention?: boolean }}
 */
function adminChangePin(currentPin, newPin) {
  if (!currentPin || typeof currentPin !== 'string' || currentPin.trim() === '') {
    return { success: false, message: 'Current PIN is required.' };
  }

  var trimmedNew = String(newPin || '').trim();
  if (!trimmedNew || trimmedNew.length < 4) {
    return { success: false, message: 'New PIN must be at least 4 characters long.' };
  }

  if (trimmedNew.length > 32) {
    return { success: false, message: 'New PIN must not exceed 32 characters.' };
  }

  if (currentPin.trim() === trimmedNew) {
    return { success: false, message: 'New PIN must be different from current PIN.' };
  }

  var lock = LockService.getScriptLock();
  var hasLock = lock.tryLock(AUTH_LOCK_TIMEOUT_MS);
  if (!hasLock) {
    return {
      success: false,
      lockContention: true,
      message: 'Server is temporarily busy. Please retry in a moment.',
    };
  }

  try {
    var props = PropertiesService.getScriptProperties();
    var configuredPin = props.getProperty('ADMIN_PIN');

    if (!configuredPin || currentPin.trim() !== configuredPin.trim()) {
      return {
        success: false,
        message: 'Current PIN is incorrect.',
      };
    }

    // Set new PIN in Script Properties
    props.setProperty('ADMIN_PIN', trimmedNew);

    return {
      success: true,
      message: 'Admin PIN changed successfully.',
    };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Retrieves the stored administrator profile information.
 *
 * @returns {{ displayName: string, email: string, role: string, status: string, authMethod: string }}
 */
function adminGetProfile() {
  var props = PropertiesService.getScriptProperties();
  var name = props.getProperty('ADMIN_NAME') || 'System Administrator';
  var email = props.getProperty('ADMIN_EMAIL') || 'admin@feedbackiq.local';

  return {
    displayName: name,
    email: email,
    role: 'Administrator',
    status: 'Active',
    authMethod: 'Server-side PIN (Script Properties)',
  };
}

/**
 * Updates administrator profile information in Script Properties.
 *
 * @param {string} displayName - Administrator display name
 * @param {string} email - Administrator email address
 * @returns {{ success: boolean, message: string, data?: Object }}
 */
function adminUpdateProfile(displayName, email) {
  var trimmedName = String(displayName || '').trim();
  var trimmedEmail = String(email || '').trim();

  if (!trimmedName) {
    return { success: false, message: 'Display Name is required.' };
  }

  if (trimmedName.length > 100) {
    return { success: false, message: 'Display Name must not exceed 100 characters.' };
  }

  if (trimmedEmail && trimmedEmail.length > 150) {
    return { success: false, message: 'Email address must not exceed 150 characters.' };
  }

  var lock = LockService.getScriptLock();
  var hasLock = lock.tryLock(AUTH_LOCK_TIMEOUT_MS);
  if (!hasLock) {
    return {
      success: false,
      lockContention: true,
      message: 'Server is temporarily busy. Please retry in a moment.',
    };
  }

  try {
    var props = PropertiesService.getScriptProperties();
    props.setProperty('ADMIN_NAME', trimmedName);
    props.setProperty('ADMIN_EMAIL', trimmedEmail);

    return {
      success: true,
      message: 'Admin profile updated successfully.',
      data: {
        displayName: trimmedName,
        email: trimmedEmail,
        role: 'Administrator',
        status: 'Active',
        authMethod: 'Server-side PIN (Script Properties)',
      },
    };
  } finally {
    lock.releaseLock();
  }
}
